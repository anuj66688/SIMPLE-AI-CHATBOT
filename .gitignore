# ============================================================
# Root .gitignore — AI Assistant Chatbot
# ============================================================

# Node dependencies
node_modules/
**/node_modules/

# Environment variables — NEVER commit secrets
.env
**/.env
.env.local
.env.production
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Build outputs
dist/
build/
.next/
out/

# Package lock (keep package-lock.json but ignore others)
yarn.lock

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log

# Vercel
.vercel
